generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int        @id @default(autoincrement())
  nama     String     @db.VarChar(255)
  nim      String     @unique @db.VarChar(100)
  password String
  role     String?    @default("mahasiswa") @db.VarChar(50)
  presensi Presensi[]

  @@map("users")
}

model Presensi {
  id         Int       @id @default(autoincrement())
  userId     Int?      @map("user_id")
  mataKuliah String    @map("mata_kuliah") @db.VarChar(255)
  latitude   String?   @db.VarChar(100)
  longitude  String?   @db.VarChar(100)
  tanggal    DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  waktu      DateTime? @default(dbgenerated("CURRENT_TIME")) @db.Time(6)
  status     String?   @default("hadir") @db.VarChar(50)
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("presensi")
}

model absensi {
  id_absensi       Int                       @id @default(autoincrement())
  id_siswa         Int
  id_jadwal        Int
  tanggal          DateTime                  @db.Date
  jam_masuk        DateTime?                 @db.Time(6)
  jam_pulang       DateTime?                 @db.Time(6)
  koordinat_masuk  Unsupported("geography")?
  koordinat_pulang Unsupported("geography")?
  foto_masuk       String?
  foto_pulang      String?
  status           AbsensiStatus
  keterangan       String?
  jadwal_absensi   jadwal_absensi            @relation(fields: [id_jadwal], references: [id_jadwal])
  siswa            siswa                     @relation(fields: [id_siswa], references: [id_siswa])
}

model admin {
  id_admin   Int     @id @default(autoincrement())
  id_user    Int     @unique
  id_sekolah Int
  nama_admin String
  sekolah    sekolah @relation(fields: [id_sekolah], references: [id_sekolah])
  user       user    @relation(fields: [id_user], references: [id_user])
}

model enrolment_guru {
  id_enrolment_guru  Int             @id @default(autoincrement())
  id_guru            Int
  id_enrolment_kelas Int
  is_active          Boolean
  enrolment_kelas    enrolment_kelas @relation(fields: [id_enrolment_kelas], references: [id_enrolment_kelas])
  guru               guru            @relation(fields: [id_guru], references: [id_guru])
}

model enrolment_kelas {
  id_enrolment_kelas    Int                   @id @default(autoincrement())
  id_sekolah            Int
  id_kelas              Int
  id_angkatan           Int
  id_tahun_akademik     Int
  keterangan            String?
  enrolment_guru        enrolment_guru[]
  master_angkatan       master_angkatan       @relation(fields: [id_angkatan], references: [id_angkatan])
  master_kelas          master_kelas          @relation(fields: [id_kelas], references: [id_kelas])
  sekolah               sekolah               @relation(fields: [id_sekolah], references: [id_sekolah])
  master_tahun_akademik master_tahun_akademik @relation(fields: [id_tahun_akademik], references: [id_tahun_akademik])
  enrolment_siswa       enrolment_siswa[]
}

model enrolment_siswa {
  id_enrolment_siswa Int             @id @default(autoincrement())
  id_siswa           Int
  id_enrolment_kelas Int
  is_active          Boolean
  enrolment_kelas    enrolment_kelas @relation(fields: [id_enrolment_kelas], references: [id_enrolment_kelas])
  siswa              siswa           @relation(fields: [id_siswa], references: [id_siswa])
}

model guru {
  id_guru        Int              @id @default(autoincrement())
  id_user        Int              @unique
  id_sekolah     Int
  nama_lengkap   String
  NIP            String           @unique
  enrolment_guru enrolment_guru[]
  sekolah        sekolah          @relation(fields: [id_sekolah], references: [id_sekolah])
  user           user             @relation(fields: [id_user], references: [id_user])
  perizinan      perizinan[]
}

model jadwal_absensi {
  id_jadwal        Int       @id @default(autoincrement())
  id_sekolah       Int
  nama_jadwal      String
  hari             String
  tanggal          DateTime  @db.Date
  jam_masuk_start  DateTime  @db.Time(6)
  jam_masuk_finish DateTime  @db.Time(6)
  jam_pulang       DateTime  @db.Time(6)
  is_libur         Boolean
  absensi          absensi[]
  sekolah          sekolah   @relation(fields: [id_sekolah], references: [id_sekolah])
}

model master_angkatan {
  id_angkatan     Int               @id @default(autoincrement())
  id_sekolah      Int
  nomor_angkatan  String
  enrolment_kelas enrolment_kelas[]
  sekolah         sekolah           @relation(fields: [id_sekolah], references: [id_sekolah])
}

model master_kelas {
  id_kelas        Int               @id @default(autoincrement())
  id_sekolah      Int
  nama_kelas      String
  enrolment_kelas enrolment_kelas[]
  sekolah         sekolah           @relation(fields: [id_sekolah], references: [id_sekolah])
}

model master_tahun_akademik {
  id_tahun_akademik Int               @id @default(autoincrement())
  id_sekolah        Int
  tahun_ajaran      String
  semester          Semester
  is_active         Boolean
  enrolment_kelas   enrolment_kelas[]
  sekolah           sekolah           @relation(fields: [id_sekolah], references: [id_sekolah])
}

model notifikasi {
  id_notifikasi Int            @id @default(autoincrement())
  id_user       Int
  judul         String
  tipe          NotifikasiTipe
  isi_pesan     String
  is_read       Boolean        @default(false)
  created_at    DateTime       @default(now())
  user          user           @relation(fields: [id_user], references: [id_user])
}

model perizinan {
  id_perizinan    Int             @id @default(autoincrement())
  id_siswa        Int
  tanggal_mulai   DateTime        @db.Date
  tanggal_selesai DateTime        @db.Date
  jenis_izin      PerizinanJenis
  alasan          String
  file_bukti      String?
  status          PerizinanStatus
  disetujui_oleh  Int?
  created_at      DateTime        @default(now())
  guru            guru?           @relation(fields: [disetujui_oleh], references: [id_guru])
  siswa           siswa           @relation(fields: [id_siswa], references: [id_siswa])
}

model role {
  id_role   Int      @id @default(autoincrement())
  nama_role RoleName
  user      user[]
}

model sekolah {
  id_sekolah            Int                      @id @default(autoincrement())
  nama_sekolah          String
  alamat                String
  radius_meter          Int
  titik_koordinat       Unsupported("geography")
  admin                 admin[]
  enrolment_kelas       enrolment_kelas[]
  guru                  guru[]
  jadwal_absensi        jadwal_absensi[]
  master_angkatan       master_angkatan[]
  master_kelas          master_kelas[]
  master_tahun_akademik master_tahun_akademik[]
  siswa                 siswa[]
}

model siswa {
  id_siswa        Int               @id @default(autoincrement())
  id_user         Int               @unique
  id_sekolah      Int
  nama_lengkap    String
  NIS             String            @unique
  face_model      String?
  absensi         absensi[]
  enrolment_siswa enrolment_siswa[]
  perizinan       perizinan[]
  sekolah         sekolah           @relation(fields: [id_sekolah], references: [id_sekolah])
  user            user              @relation(fields: [id_user], references: [id_user])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

model user {
  id_user    Int          @id @default(autoincrement())
  id_role    Int
  username   String       @unique
  password   String
  email      String       @unique
  fcm_token  String?
  admin      admin?
  guru       guru?
  notifikasi notifikasi[]
  siswa      siswa?
  role       role         @relation(fields: [id_role], references: [id_role])
}

enum AbsensiStatus {
  Hadir
  Telat
  Alpha
  Izin
  Sakit
}

enum NotifikasiTipe {
  Sistem
  Pengingat
  Peringatan
}

enum PerizinanJenis {
  Sakit
  Kepentingan
}

enum PerizinanStatus {
  Pending
  Disetujui
  Ditolak
}

enum RoleName {
  Admin
  Guru
  Siswa
}

enum Semester {
  Ganjil
  Genap
}
