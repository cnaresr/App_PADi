<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manajemen Guru - Sistem PADi</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        body { background-color: #f8f9fa; }
        .card { border: none; box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.075); }
    </style>
</head>
<body class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manajemen Data Guru</h2>
        <a href="/dashboard" class="btn btn-secondary">Kembali ke Dashboard</a>
    </div>

    <div class="card">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Daftar Guru Terdaftar</h5>
            <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalTambah">Tambah Guru</button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">No</th>
                            <th>NIP</th>
                            <th>Nama Lengkap</th>
                            <th>Email</th>
                            <th class="text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (gurus && gurus.length > 0) { %>
                            <% gurus.forEach((guru, index) => { %>
                                <tr>
                                    <td class="ps-3"><%= index + 1 %></td>
                                    <td><%= guru.nip %></td>
                                    <td><strong><%= guru.namaLengkap %></strong></td>
                                    <td><%= guru.user ? guru.user.email : '-' %></td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-warning" onclick="editGuru('<%= JSON.stringify(guru) %>')">Edit</button>
                                        <button class="btn btn-sm btn-danger" onclick="hapusGuru('<%= guru.id %>')">Hapus</button>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">Belum ada data guru terdaftar.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal Tambah Guru -->
    <div class="modal fade" id="modalTambah" tabindex="-1">
        <div class="modal-dialog">
            <form id="formTambahGuru" class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Tambah Guru Baru</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body row g-3">
                    <div class="col-12">
                        <label class="form-label small fw-bold">NIP Guru</label>
                        <input type="text" name="NIP" class="form-control" required placeholder="Contoh: 198203..." oninput="this.value = this.value.replace(/[^0-9]/g, '')" inputmode="numeric">
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-bold">Nama Lengkap</label>
                        <input type="text" name="nama_lengkap" class="form-control" required placeholder="Nama dan Gelar">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Username</label>
                        <input type="text" name="username" class="form-control" required placeholder="username_guru">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Email Aktif</label>
                        <input type="email" name="email" class="form-control" required placeholder="guru@mail.com">
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-bold">Password</label>
                        <input type="password" name="password" class="form-control" required placeholder="Minimal 6 karakter">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary">Simpan Data</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Edit Guru -->
    <div class="modal fade" id="modalEdit" tabindex="-1">
        <div class="modal-dialog">
            <form id="formEditGuru" method="POST" class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">Perbarui Data Guru</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body row g-3">
                    <div class="col-12">
                        <label class="form-label small fw-bold">NIP</label>
                        <input type="text" name="NIP" id="edit_nip" class="form-control" required oninput="this.value = this.value.replace(/[^0-9]/g, '')" inputmode="numeric">
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-bold">Nama Lengkap</label>
                        <input type="text" name="nama_lengkap" id="edit_nama" class="form-control" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Username</label>
                        <input type="text" name="username" id="edit_username" class="form-control" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Email</label>
                        <input type="email" name="email" id="edit_email" class="form-control" required>
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-bold">Password (Kosongkan jika tidak diubah)</label>
                        <input type="password" name="password" class="form-control" placeholder="******">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-warning">Perbarui Data</button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Menangani Notifikasi dari URL Query
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('success')) Swal.fire('Berhasil!', urlParams.get('success'), 'success');
        if (urlParams.has('error')) Swal.fire('Error!', urlParams.get('error'), 'error');

        // CREATE: Menangani Submit Form Tambah Guru (AJAX)
        document.getElementById('formTambahGuru').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const dataObjek = Object.fromEntries(formData.entries());

            // VALIDASI NIP: Hanya Angka
            if (!/^\d+$/.test(dataObjek.NIP)) {
                return Swal.fire('Peringatan!', 'NIP hanya boleh berisi angka.', 'warning');
            }

            try {
                // Gunakan rute internal '/daftar-guru/tambah' agar diproses app.js yang memegang token session
                const response = await fetch('/daftar-guru/tambah', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams(dataObjek)
                });

                const result = await response.json();
                if (result.status === 'success') {
                    Swal.fire('Berhasil!', result.message, 'success')
                        .then(() => window.location.reload()); // Refresh untuk melihat update tabel (SSR)
                } else {
                    Swal.fire('Gagal!', result.message || 'Terjadi kesalahan saat menyimpan data.', 'error');
                }
            } catch (error) {
                console.error(error);
                Swal.fire('Error!', 'Gagal menghubungi server.', 'error');
            }
        });

        // UPDATE: Menangani Submit Form Edit Guru (AJAX)
        document.getElementById('formEditGuru').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const dataObjek = Object.fromEntries(formData.entries());

            // VALIDASI NIP: Hanya Angka
            if (!/^\d+$/.test(dataObjek.NIP)) {
                return Swal.fire('Peringatan!', 'NIP hanya boleh berisi angka.', 'warning');
            }

            try {
                const response = await fetch(e.target.action, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams(dataObjek)
                });

                const result = await response.json();
                if (result.status === 'success') {
                    Swal.fire('Berhasil!', result.message, 'success')
                        .then(() => window.location.reload());
                } else {
                    Swal.fire('Gagal!', result.message || 'Terjadi kesalahan.', 'error');
                }
            } catch (error) {
                Swal.fire('Error!', 'Gagal menghubungi server.', 'error');
            }
        });

        // UPDATE: Mengisi Data ke Modal Edit
        function editGuru(guruRaw) {
            const guru = JSON.parse(guruRaw);
            document.getElementById('formEditGuru').action = `/daftar-guru/edit/${guru.id}`;
            document.getElementById('edit_nip').value = guru.nip;
            document.getElementById('edit_nama').value = guru.namaLengkap;
            document.getElementById('edit_username').value = guru.user.username;
            document.getElementById('edit_email').value = guru.user.email;
            new bootstrap.Modal(document.getElementById('modalEdit')).show();
        }

        // DELETE: Konfirmasi Hapus
        function hapusGuru(id) {
            Swal.fire({
                title: 'Hapus Guru?',
                text: "Akun login dan profil guru ini akan dihapus permanen.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Ya, Hapus',
                cancelButtonText: 'Batal'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = `/daftar-guru/hapus/${id}`;
                }
            });
        }
    </script>
</body>
</html>